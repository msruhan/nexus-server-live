# Paste into Vercel → Project → Settings → Environment Variables (Production)
# Generate secrets: openssl rand -base64 32

# ─── Database (Supabase) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── URLs (replace after custom domain) ──────────────────────
AUTH_TRUST_HOST=true
AUTH_URL=https://YOUR-PROJECT.vercel.app
NEXTAUTH_URL=https://YOUR-PROJECT.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app

# ─── Secrets (required in production) ────────────────────────
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# ─── Vercel demo / marketing (recommended) ───────────────────
# Schedulers are off on Vercel unless ENABLE_BACKGROUND_JOBS=true
ENABLE_BACKGROUND_JOBS=false
IMEI_ORDER_SCHEDULER_ENABLED=false
SERVER_ORDER_SCHEDULER_ENABLED=false
WEBHOOK_SCHEDULER_ENABLED=false
BACKUP_SCHEDULER_ENABLED=false

# ─── Optional ────────────────────────────────────────────────
# NEXUS_LICENSE_SERVER_URL=
# LICENSE_API_SIGNING_SECRET=
