// Nexus Server — Prisma schema (PostgreSQL / Supabase for production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct connection — used by `prisma db push` / migrate (not the pooler URL).
  directUrl = env("DIRECT_URL")
}

// ─── Auth & User ────────────────────────────────────────────────
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER") // ADMIN | SUB_ADMIN | USER
  isActive  Boolean  @default(true)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? @db.Text

  // Optional pricing tier. Null = retail (uses service.price as-is).
  priceGroupId String?

  // ─── Telegram linking ─────────────────────────────────────────
  telegramChatId        String?
  telegramUsername      String?
  telegramLinkCode      String?
  telegramLinkExpiresAt DateTime?
  telegramLinkedAt      DateTime?
  telegramNotifyEnabled Boolean @default(true)

  // Per-account dashboard palette (member desk / admin bureau — independent per user)
  paletteTemplate String  @default("editorial")
  paletteCustom   String? // JSON partial PaletteTokens overrides

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet       Wallet?
  imeiOrders   ImeiOrder[]
  serverOrders ServerOrder[]
  topupRequests TopupRequest[]
  activityLogs ActivityLog[]
  backupCodes  BackupCode[]
  apiKeys      ApiKey[]
  supportTickets SupportTicket[]
  priceGroup   PriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: SetNull)
  paymentIntents PaymentIntent[]
  marketplaceCheckouts MarketplaceCheckout[]
  subAdminPermissions SubAdminPermission?
  invoices       Invoice[]
  webhookEndpoints WebhookEndpoint[]
  apiIpWhitelist   IpWhitelistEntry?

  @@index([priceGroupId])
}

// ─── Sub-Admin Permissions ──────────────────────────────────────
// Granular permission set for SUB_ADMIN users. Each boolean field
// maps to a specific admin feature/page. ADMIN role bypasses all
// checks (full access). SUB_ADMIN must have explicit permission.
model SubAdminPermission {
  id     String @id @default(cuid())
  userId String @unique

  // Dashboard
  viewDashboard          Boolean @default(false)

  // Orders
  viewImeiOrders         Boolean @default(false)
  viewServerOrders       Boolean @default(false)
  cancelRefundOrders     Boolean @default(false)

  // Services
  viewImeiServices       Boolean @default(false)
  editImeiServices       Boolean @default(false)
  viewServerServices     Boolean @default(false)
  editServerServices     Boolean @default(false)
  manageServiceGroups    Boolean @default(false)

  // API Providers
  viewProviders          Boolean @default(false)
  editProviders          Boolean @default(false)
  syncServices           Boolean @default(false)

  // Users & Wallet
  viewUsers              Boolean @default(false)
  editUsers              Boolean @default(false)
  viewWalletTopups       Boolean @default(false)
  approveTopups          Boolean @default(false)
  managePriceGroups      Boolean @default(false)

  // Support Tickets
  viewTickets            Boolean @default(false)
  replyTickets           Boolean @default(false)
  closeTickets           Boolean @default(false)

  // CMS
  viewCms                Boolean @default(false)
  editCms                Boolean @default(false)

  // Settings & System
  viewSettings           Boolean @default(false)
  editSettings           Boolean @default(false)
  viewActivityLog        Boolean @default(false)
  manageApiKeys          Boolean @default(false)
  managePaymentGateways  Boolean @default(false)
  manageEmailSettings    Boolean @default(false)
  manageTelegram         Boolean @default(false)
  manageSystem           Boolean @default(false)
  viewReports            Boolean @default(false)
  manageWebhooks         Boolean @default(false)
  manageSubAdmins        Boolean @default(false)
  manageBackups          Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  apiUsername String?  @unique
  keyPrefix   String   @unique
  keyHash     String
  scopes      String   @default("orders:write,orders:read,services:read")
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── Security hardening (P1) ────────────────────────────────
  // All fields below are OPTIONAL and DEFAULT to legacy behavior.
  // Existing keys keep working unchanged unless owner opts in.

  // IP policy: "none" | "allowlist" | "lock_first"
  ipMode      String   @default("none")
  // CSV of IPs / CIDRs (used when ipMode = "allowlist")
  allowedIps  String?
  // First seen IP (used when ipMode = "lock_first"); auto-bound on first call.
  lockedIp    String?
  lockedAt    DateTime?
  lockedByUa  String?  @db.Text

  // Rate limits (per this key). null = no limit.
  rateLimitPerMinute Int?
  rateLimitPerHour   Int?

  // ─── Financial circuit breakers (per this key). null = no limit.
  // All amounts in USD, matching wallet currency.
  spendLimitPerDay   Decimal? @db.Decimal(14, 2)
  spendLimitPerHour  Decimal? @db.Decimal(14, 2)
  maxOrdersPerHour   Int?

  // Auto-throttle on consecutive failures (auth/scope/balance).
  consecutiveFails   Int      @default(0)
  throttleUntil      DateTime?

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts ApiKeyAttemptLog[]
  buckets  ApiKeyRateBucket[]

  @@index([userId, isActive])
  @@index([isActive, expiresAt])
}

// Audit log of accepted + rejected API key calls. Trimmed by background job
// (we keep last 200 per key to bound storage).
model ApiKeyAttemptLog {
  id        String   @id @default(cuid())
  apiKeyId  String
  outcome   String   // "ALLOWED" | "REJECTED_IP" | "REJECTED_SCOPE" | "REJECTED_RATE" | "REJECTED_SPEND" | "REJECTED_AUTH" | "REJECTED_THROTTLE"
  reason    String?  @db.Text
  ip        String?
  ipCountry String?
  userAgent String?  @db.Text
  action    String?
  createdAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, createdAt])
  @@index([apiKeyId, outcome, createdAt])
}

// Sliding-window rate limit buckets (per key + action + minute floor).
model ApiKeyRateBucket {
  id        String   @id @default(cuid())
  apiKeyId  String
  scope     String   // "minute" | "hour"
  bucketAt  DateTime // floor to start of minute/hour
  count     Int      @default(0)

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, scope, bucketAt])
  @@index([bucketAt])
}

// ─── Wallet & Ledger ────────────────────────────────────────────
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger WalletLedger[]
}

model WalletLedger {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // TOPUP | PAYMENT | REFUND
  amount      Decimal  @db.Decimal(14, 2)
  balance     Decimal  @db.Decimal(14, 2)
  description String?
  referenceId String?
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

model TopupRequest {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(14, 2)
  proofUrl    String?
  note        String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
}

// ─── IMEI / Server API Management (1:1 IndoTeknizi) ─────────────

enum ImeiApiStatus {
  ACTIVE
  INACTIVE
}

enum ImeiServiceStatus {
  ACTIVE
  INACTIVE
}

enum ImeiOrderStatus {
  PENDING
  IN_PROCESS
  SUCCESS
  REJECTED
  CANCELLED
}

enum ServerOrderStatus {
  PENDING
  IN_PROCESS
  SUCCESS
  REJECTED
  CANCELLED
}

model ImeiApi {
  id        String        @id @default(cuid())
  title     String
  host      String
  username  String
  apiKey    String        @db.Text
  apiType   String        @default("DhruFusion")
  libraryId Int           @default(1)
  status    ImeiApiStatus @default(ACTIVE)
  notes     String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  services       ImeiService[]
  serverServices ServerService[]

  @@index([status])
}

model ImeiServiceGroup {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?
  marketplaceVisible Boolean @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services ImeiService[]
}

model ImeiService {
  id           String            @id @default(cuid())
  apiId        String
  groupId      String
  toolId       String?
  title        String
  description  String?           @db.Text
  price        Decimal           @db.Decimal(12, 2)
  deliveryTime String?
  status       ImeiServiceStatus @default(ACTIVE)

  requiresImei     Boolean @default(true)
  requiresNetwork  Boolean @default(false)
  requiresModel    Boolean @default(false)
  requiresProvider Boolean @default(false)
  requiresPin      Boolean @default(false)
  requiresKbh      Boolean @default(false)
  requiresMep      Boolean @default(false)
  requiresPrd      Boolean @default(false)
  requiresSn       Boolean @default(false)
  requiresEcid     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  api    ImeiApi          @relation(fields: [apiId], references: [id], onDelete: Cascade)
  group  ImeiServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orders ImeiOrder[]

  @@index([groupId, status])
  @@index([apiId])
}

model ImeiOrder {
  id        String          @id @default(cuid())
  orderCode String          @unique
  userId    String
  serviceId String
  imei      String
  price     Decimal         @db.Decimal(12, 2)
  status    ImeiOrderStatus @default(PENDING)

  network      String?
  model        String?
  provider     String?
  pin          String?
  kbh          String?
  mep          String?
  prd          String?
  serialNumber String?
  ecid         String?
  note         String? @db.Text

  code        String? @db.Text
  comments    String? @db.Text
  referenceId String?

  // ─── Reseller callback (Dhru-compatible, additive) ──────────────
  // Caller-supplied idempotency key + feedback URL. All optional; when
  // absent the order behaves exactly as before. quantity defaults to 1.
  callerReference String?
  feedbackUrl     String?  @db.Text
  feedbackStatus  String?  // null | "PENDING" | "SENT" | "FAILED"
  quantity        Int      @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?
  completedAt DateTime?

  user    User        @relation(fields: [userId], references: [id])
  service ImeiService @relation(fields: [serviceId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([imei])
}

model ServerServiceBox {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?
  marketplaceVisible Boolean @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services ServerService[]
}

model ServerService {
  id             String            @id @default(cuid())
  apiId          String
  boxId          String
  toolId         String?
  title          String
  description    String?           @db.Text
  price          Decimal           @db.Decimal(12, 2)
  deliveryTime   String?
  quantity       Int               @default(1)
  requiredFields String?           @db.Text
  status         ImeiServiceStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  api    ImeiApi          @relation(fields: [apiId], references: [id], onDelete: Cascade)
  box    ServerServiceBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  orders ServerOrder[]

  @@index([boxId, status])
  @@index([apiId])
}

model ServerOrder {
  id             String            @id @default(cuid())
  orderCode      String            @unique
  userId         String
  serviceId      String
  price          Decimal           @db.Decimal(12, 2)
  status         ServerOrderStatus @default(PENDING)
  requiredFields String?           @db.Text
  email          String?
  notes          String?           @db.Text
  code           String?           @db.Text
  comments       String?           @db.Text
  referenceId    String?

  // ─── Reseller callback (Dhru-compatible, additive) ──────────────
  callerReference String?
  feedbackUrl     String?  @db.Text
  feedbackStatus  String?  // null | "PENDING" | "SENT" | "FAILED"
  quantity        Int      @default(1)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  processedAt    DateTime?
  completedAt    DateTime?

  user    User          @relation(fields: [userId], references: [id])
  service ServerService @relation(fields: [serviceId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
}

// ─── Activity Log ───────────────────────────────────────────────
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  String?  // JSON-as-string
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
}

// ─── CMS ────────────────────────────────────────────────────────
model SiteSettings {
  id                  String   @id @default("singleton")
  siteName            String   @default("Recovero")
  siteTagline         String   @default("IMEI & Server Bureau")
  logoUrl             String?
  faviconUrl          String?
  themeMode           String   @default("light")
  primaryColor        String   @default("#2f63ff")
  accentColor         String   @default("#06b6d4")

  // Palette template + custom overrides
  paletteTemplate     String   @default("editorial") // template id
  paletteCustom       String?  // JSON-as-string of PaletteTokens partial overrides

  metaTitle           String?
  metaDescription     String?
  metaKeywords        String?
  ogImage             String?

  socialInstagram     String?
  socialTiktok        String?
  socialWhatsapp      String?
  socialTelegram      String?
  socialFacebook      String?
  socialYoutube       String?

  footerText          String?
  copyrightText       String?
  /// JSON: newsletter block, link columns, link mode (see lib/footer-content.ts)
  footerContent       String?

  // ─── White-label / branding ────────────────────────────────────
  // Full rebrand controls. All optional & non-breaking. When
  // brandShowPoweredBy=true (default) a small "Powered by Nexus Server"
  // line is shown in the footer; a licensed reseller can turn it off.
  brandShowPoweredBy  Boolean  @default(true)
  supportEmail        String?
  /// Inbox for admin alert emails (new orders, top-ups, tickets). Falls back to supportEmail.
  adminNotificationEmail String?
  brandInvoicePrefix  String?  // e.g. "INV" → INV-2026-0001 on invoices

  enableDarkMode      Boolean  @default(true)
  enableRegistration  Boolean  @default(true)
  enableDirectPayment Boolean  @default(false)
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?
  // Maintenance page customization
  maintenanceTitle    String?
  maintenanceTemplate String   @default("aurora") // aurora | grid | orbit | minimal
  maintenanceEndsAt   DateTime? // optional countdown target

  // Security policy
  // When true, ADMIN users without 2FA are redirected to the 2FA setup
  // page on every admin route hit until they enable it. This is OPT-IN
  // (default false) so existing deployments are not surprised by lockouts.
  enforceAdmin2FA     Boolean  @default(false)

  // ─── Payment gateway feature flags ────────────────────────────
  // All gateways are OPT-IN. With every flag false (default), the
  // top-up flow keeps using manual admin-approved transfers exactly
  // as before — no behavioral change for existing deployments.
  paymentUsdtPortalEnabled         Boolean @default(false)
  paymentUsdtPortalEmail           String?
  paymentUsdtPortalApiKey          String? @db.Text
  paymentUsdtPortalCallbackPassword String? @db.Text

  paymentPaypalEnabled     Boolean @default(false)
  paymentPaypalClientId    String?
  paymentPaypalClientSecret String? @db.Text
  // PayPal mode: "sandbox" | "live"
  paymentPaypalMode        String   @default("sandbox")
  // Webhook ID from PayPal dashboard, used for signature verification.
  paymentPaypalWebhookId   String?

  paymentStripeEnabled     Boolean @default(false)
  paymentStripeSecretKey   String?  @db.Text
  paymentStripePublishableKey String?
  paymentStripeWebhookSecret String? @db.Text

  /// When true, API key requests must come from an IP in IpWhitelistEntry.
  apiIpWhitelistEnforced   Boolean @default(false)

  // USD per 1 USDT — used by USDT Portal to convert the user's USD
  // wallet amount to USDT for the hosted checkout.
  // Example: 1.00 means 1 USD = 1 USDT (1:1 peg).
  paymentUsdtRate    Decimal? @db.Decimal(10, 6)

  // ─── Telegram Bot ────────────────────────────────────────────────
  // OPT-IN. With telegramBotEnabled=false (default), all Telegram
  // features are no-ops. No regression vs. existing deployments.
  telegramBotEnabled     Boolean @default(false)
  telegramBotToken       String? @db.Text
  telegramBotUsername    String?
  telegramWebhookSecret  String?
  telegramAdminChatId    String?
  telegramChannelId      String?
  telegramChannelEnabled Boolean @default(false)
  // Comma-separated allow-list of enabled notification events.
  // null = all enabled (default, non-breaking). "" = none enabled.
  // e.g. "order.created,order.success,payment.credited"
  telegramUserEvents     String?
  telegramAdminEvents    String?

  // ─── Licensing & Updates ───────────────────────────────────────
  // License validation against the external NexusPortal (License Server).
  // With licenseStatus="not_activated" (default), the system runs normally
  // but cannot check for or apply updates.
  licenseKey             String?  @db.Text
  licenseStatus          String   @default("not_activated") // active | inactive | not_activated
  licenseDomain          String?
  licensePlan            String?
  licenseExpiresAt       DateTime?
  licenseLastValidated   DateTime?
  licenseReason          String?  // reason if inactive (e.g. "hold", "expired", "grace_period_exceeded")
  licensePortalStatus    String?  // last Portal status: active | hold | expired | …
  licenseTier            String?  // monthly | yearly | lifetime
  licenseRuntimeAllowed  Boolean  @default(true)
  licenseUpdatesAllowed  Boolean  @default(true)
  licenseRenewalCheckoutUrl String?
  licenseRenewalDeskUrl     String?
  lastUpdateVersion      String?
  lastUpdateAt           DateTime?
  /// Set when a Docker update starts; used to record history after container recreate.
  pendingUpdateFromVersion   String?
  pendingUpdateTargetVersion String?

  // ─── SMTP / Email ──────────────────────────────────────────────
  // OPT-IN. With smtpEnabled=false (default), the email service is a
  // no-op: every send call returns ok=false silently. No regression vs.
  // existing deployments which never had email at all.
  smtpEnabled       Boolean @default(false)
  smtpHost          String?
  smtpPort          Int?    @default(587)
  smtpSecure        Boolean @default(false)  // TLS on connect (465). false = STARTTLS on 587/25.
  smtpUsername      String?
  smtpPassword      String? @db.Text
  smtpFromAddress   String?
  smtpFromName      String?
  // Comma-separated allow-list of event types to send. Empty = all enabled.
  // e.g. "ticket.reply,order.success,payment.credited"
  smtpEvents        String?

  // ─── Database Backups ──────────────────────────────────────────
  // OPT-IN automated backups. With backupScheduleEnabled=false (default),
  // no scheduled backups run; admins can still trigger manual backups.
  backupScheduleEnabled   Boolean @default(false)
  // Frequency of scheduled backups: "daily" | "weekly" | "monthly".
  backupFrequency         String  @default("daily")
  // Hour of day (0-23, server local time) to run scheduled backups.
  backupHour              Int     @default(3)
  // How many of the most recent backups to keep. Older ones are pruned.
  backupRetention         Int     @default(7)
  // Email the backup file as an attachment after each backup.
  backupEmailEnabled      Boolean @default(false)
  // Recipient address. When empty, falls back to smtpFromAddress.
  backupEmailTo           String?
  // Bookkeeping for the scheduler.
  backupLastRunAt         DateTime?
  backupNextRunAt         DateTime?

  updatedAt           DateTime @updatedAt
}

// History of database backups (manual + scheduled). The dump file lives on
// disk under BACKUP_DIR; this row tracks metadata + status.
model DatabaseBackup {
  id          String   @id @default(cuid())
  filename    String   // file on disk under BACKUP_DIR
  sizeBytes   BigInt   @default(0)
  // "manual" | "daily" | "weekly" | "monthly"
  trigger     String   @default("manual")
  // "pending" | "success" | "failed"
  status      String   @default("pending")
  error       String?  @db.Text
  // userId of the admin who triggered a manual backup (null for scheduled).
  createdBy   String?
  durationMs  Int?
  // Email delivery: null = not attempted, otherwise timestamp; emailError set on failure.
  emailedAt   DateTime?
  emailError  String?  @db.Text
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status, startedAt])
  @@index([trigger, startedAt])
}

model PageSection {
  id          String   @id @default(cuid())
  pageSlug    String   @default("home")
  sectionType String
  title       String?
  subtitle    String?
  content     String   @default("{}") // JSON-as-string
  settings    String   @default("{}")
  isVisible   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pageSlug, isVisible, sortOrder])
}

model Banner {
  id         String    @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String
  linkUrl    String?
  position   String    @default("home_top")
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  startDate  DateTime?
  endDate    DateTime?
  clickCount Int       @default(0)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([position, isActive, sortOrder])
}

model RunningAd {
  id        String    @id @default(cuid())
  text      String
  linkUrl   String?
  bgColor   String?
  textColor String?
  icon      String?
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model NavigationMenu {
  id         String   @id @default(cuid())
  location   String
  label      String
  href       String
  icon       String?
  isExternal Boolean  @default(false)
  isVisible  Boolean  @default(true)
  sortOrder  Int      @default(0)
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([location, isVisible, sortOrder])
}

model FaqItem {
  id        String   @id @default(cuid())
  category  String   @default("general")
  question  String
  answer    String
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isVisible, sortOrder])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  avatar    String?
  role      String?
  rating    Int      @default(5)
  content   String
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaFile {
  id         String   @id @default(cuid())
  filename   String
  url        String
  mimeType   String
  size       Int
  altText    String?
  uploadedBy String?
  folder     String   @default("general")
  createdAt  DateTime @default(now())
}

model CustomPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Tiered Pricing (Customer Groups) ──────────────────────────
//
// Strictly additive. A user with no priceGroup uses service.price as-is.
// Group rule: PERCENT off retail, or FIXED +/- USD on retail.
// Per-service override price always wins over the group rule.
model PriceGroup {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?  @db.Text
  // PERCENT = apply discountPercent | FIXED = add fixedAdjustment to retail (e.g. -5 or +5 USD)
  adjustmentType  String   @default("PERCENT")
  // Global discount percent (when adjustmentType = PERCENT). Example: 10 → 10% off.
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  // USD delta on retail (when adjustmentType = FIXED). Negative = cheaper, positive = markup.
  fixedAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users     User[]
  overrides ServicePriceOverride[]
}

// Per-service override for a specific group. Wins over discountPercent.
// Either imeiServiceId OR serverServiceId is set, never both.
model ServicePriceOverride {
  id              String   @id @default(cuid())
  priceGroupId    String
  imeiServiceId   String?
  serverServiceId String?
  price           Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  priceGroup PriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  @@unique([priceGroupId, imeiServiceId])
  @@unique([priceGroupId, serverServiceId])
  @@index([imeiServiceId])
  @@index([serverServiceId])
}

// ─── Payment Gateways ──────────────────────────────────────────
//
// PaymentIntent represents a request to top up the wallet via an external
// gateway. The supplier order workflow is unaffected — wallet credit only
// happens once a webhook (or poller) confirms the payment.
//
// All amounts are in USD (2 decimal places).
model PaymentIntent {
  id              String   @id @default(cuid())
  reference       String   @unique // public reference shared with gateway / user
  userId          String
  gateway         String   // "usdt_portal" | "paypal" | "stripe" | ...

  // Wallet credit on success (USD).
  amount          Decimal  @db.Decimal(14, 2)

  // Source asset details (crypto). null for fiat gateways.
  cryptoAsset     String?  // "USDT-TRC20"
  cryptoAmount    String?  // string to preserve precision (e.g. "12.345600")
  cryptoAddress   String?  // deposit address presented to user

  status          String   @default("PENDING") // "PENDING" | "DETECTED" | "CONFIRMED" | "EXPIRED" | "FAILED" | "CANCELLED"
  confirmations   Int      @default(0)
  txHash          String?  // chain tx hash (crypto), or gateway transaction id (fiat)

  // Free-form gateway response payload for debugging.
  gatewayPayload  String?  @db.Text

  // External hosted-checkout URL (USDT Portal etc.) so the user can be
  // redirected back later from "view intent" without re-creating it.
  externalUrl     String?

  expiresAt       DateTime
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaceCheckout MarketplaceCheckout?

  @@index([userId, status])
  @@index([gateway, status])
  @@index([status, expiresAt])
}

model MarketplaceCheckout {
  id              String   @id @default(cuid())
  token           String   @unique
  kind            String   // "imei" | "server"
  userId          String
  serviceId       String
  email           String
  gateway         String
  quotedAmount    Decimal  @db.Decimal(14, 2)
  payload         String   @db.Text // JSON payload for order fields
  status          String   @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | PROCESSING | COMPLETED | FAILED
  paymentIntentId String?  @unique
  orderType       String?  // "imei" | "server"
  orderId         String?
  errorMessage    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([kind, serviceId, status])
  @@index([status, createdAt])
}

// Audit + retry queue for outbound email. Sends are best-effort: a row
// here does not block the originating action (ticket reply etc.).
model EmailLog {
  id          String   @id @default(cuid())
  toAddress   String
  subject     String
  event       String   // "ticket.reply" | "order.success" | etc.
  status      String   @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  attempts    Int      @default(0)
  lastError   String?  @db.Text
  bodyText    String?  @db.Text
  bodyHtml    String?  @db.Text
  refType     String?  // entity type for grouping ("SupportTicket", "ImeiOrder", ...)
  refId       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
  @@index([refType, refId])
}

// ─── Support Tickets ────────────────────────────────────────────
//
// Threaded support conversations between users and admins. Optionally
// attached to an IMEI/Server order so that supplier file responses
// (FILE_URL etc.) and other context can be threaded together.
//
// Designed to NEVER touch the order workflow itself — tickets are a
// parallel, additive model. Order rows are referenced by id (no FK
// cascade) so deleting a ticket has no effect on order processing.
model SupportTicket {
  id          String   @id @default(cuid())
  ticketCode  String   @unique // e.g. "TCK-2026-AB12CD"
  userId      String
  subject     String
  category    String   @default("general") // "general" | "order" | "billing" | "technical"
  priority    String   @default("normal")  // "low" | "normal" | "high" | "urgent"
  status      String   @default("OPEN")    // "OPEN" | "AWAITING_USER" | "AWAITING_ADMIN" | "RESOLVED" | "CLOSED"

  // Optional cross-reference to an order. We use opaque string ids and
  // do NOT add FK relations so that deleting a ticket cannot cascade
  // into order rows under any circumstance.
  imeiOrderId   String?
  serverOrderId String?

  lastReplyAt   DateTime?
  lastReplyBy   String?  // "USER" | "ADMIN"
  closedAt      DateTime?
  closedBy      String?  // userId of admin who closed

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies SupportTicketReply[]

  @@index([userId, status])
  @@index([status, lastReplyAt])
  @@index([category, status])
}

model SupportTicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String?  // null for system events
  authorRole String   // "USER" | "ADMIN" | "SYSTEM"
  body       String   @db.Text
  // JSON-as-string array of attachments: [{ url, filename, mimeType, size }]
  attachments String? @db.Text
  // System-generated entries (status change, attached order, ...) are
  // visually distinct from real replies. They never count as "replied
  // by user/admin" for the AWAITING_* status flip.
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ─── Download tools library ────────────────────────────────────
model DownloadTool {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  category    String   @default("general")
  version     String?
  platform    String? // e.g. Windows, macOS, Linux, Multi
  downloadUrl String   @db.Text
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([category, isPublished])
}

// ─── System Update Log ─────────────────────────────────────────
// Records every update attempt (success or failure) for the admin
// System & Update page history view.
model UpdateLog {
  id              String   @id @default(cuid())
  fromVersion     String
  toVersion       String
  status          String   // "success" | "failed" | "rolled_back"
  error           String?  @db.Text
  appliedAt       DateTime @default(now())
  durationSeconds Int?

  @@index([appliedAt])
}

// ─── Global IP policy (admin-managed) ───────────────────────────
// Block: site-wide deny (web + API). Whitelist: required for external API sync.
model IpBlockEntry {
  id        String   @id @default(cuid())
  ip        String   @unique // IPv4, IPv6, or CIDR e.g. 203.0.113.0/24
  label     String?
  note      String?  @db.Text
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model IpWhitelistEntry {
  id        String   @id @default(cuid())
  ip        String   @unique
  label     String?
  note      String?  @db.Text
  createdBy String?
  // Set when a reseller registers their server IP (max one per user).
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

// ─── Invoices / Receipts ────────────────────────────────────────
//
// A lightweight, additive billing record. An invoice is created for
// wallet top-ups (when approved/credited) and, optionally, for orders.
// It NEVER affects the order or supplier workflow — it is a read model
// generated alongside existing events. PDF is rendered on-demand.
//
// kind:
//   "TOPUP" → wallet credit (references TopupRequest or PaymentIntent)
//   "ORDER" → an order purchase (references ImeiOrder / ServerOrder)
model Invoice {
  id            String   @id @default(cuid())
  number        String   @unique // e.g. "INV-2026-000123"
  userId        String
  kind          String   @default("TOPUP") // "TOPUP" | "ORDER"
  status        String   @default("PAID")  // "PAID" | "REFUNDED" | "VOID"

  // Monetary fields (USD, matching wallet currency).
  amount        Decimal  @db.Decimal(14, 2)
  currency      String   @default("USD")

  // Human-readable line description, e.g. "Wallet top-up" or service title.
  description   String

  // Opaque cross-references (NO FK relations — never cascades into orders).
  refType       String?  // "TopupRequest" | "PaymentIntent" | "ImeiOrder" | "ServerOrder"
  refId         String?
  orderCode     String?  // convenience copy for order invoices

  // Snapshot of buyer + seller identity at issue time so historical
  // invoices stay correct even if branding later changes.
  sellerName    String?
  sellerEmail   String?
  buyerName     String?
  buyerEmail    String?

  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, issuedAt])
  @@index([kind, issuedAt])
  @@index([refType, refId])
}

// ─── Outgoing Webhooks (Reseller integration) ──────────────────
//
// A reseller registers an endpoint URL to receive PUSH notifications when
// their order status changes (success / rejected) or a payment is credited.
// This is OUTBOUND from NexusServer → reseller's own system. It complements
// the inbound API (REST + Dhru) without touching the order/supplier flow.
//
// Delivery is decoupled & idempotent: a background dispatcher scans for
// pending deliveries and POSTs them. The order workers are NEVER modified.
model WebhookEndpoint {
  id          String   @id @default(cuid())
  userId      String
  name        String   // human label, e.g. "Production callback"
  url         String   @db.Text // HTTPS endpoint (validated, no private IPs)
  secret      String   @db.Text // HMAC-SHA256 signing secret (shown once)
  isActive    Boolean  @default(true)

  // Comma-separated allow-list of subscribed events.
  // Empty/null = all events. e.g. "order.success,order.rejected"
  events      String?

  // Health snapshot (updated by dispatcher).
  lastStatus    String?   // "success" | "failed"
  lastDeliveryAt DateTime?
  failureCount  Int       @default(0) // consecutive failures; auto-pause threshold

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId, isActive])
}

model WebhookDelivery {
  id          String   @id @default(cuid())
  endpointId  String
  event       String   // "order.success" | "order.rejected" | "payment.credited"
  status      String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"

  // The exact JSON body that was (or will be) sent.
  payload     String   @db.Text

  // Idempotency / dedup tag so the same (endpoint, event, ref) is queued once.
  refType     String?  // "ImeiOrder" | "ServerOrder" | "PaymentIntent"
  refId       String?

  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  nextAttemptAt DateTime @default(now())

  responseCode Int?
  responseBody String?  @db.Text
  error        String?  @db.Text

  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@unique([endpointId, event, refType, refId])
}

// ─── Per-order Feedback Callback (Dhru-compatible) ──────────────
//
// When an inbound order is placed with a `feedback_url` (Dhru Fusion Pro
// style), we record a delivery here and POST the status change to that URL
// when the order completes. Fully decoupled from the supplier workers —
// a background notifier scans completed orders and enqueues deliveries,
// then the dispatcher sends them with retry/backoff. Never blocks ordering.
model FeedbackDelivery {
  id          String   @id @default(cuid())
  orderKind   String   // "imei" | "server"
  orderId     String   // ImeiOrder.id or ServerOrder.id (opaque, no FK)
  url         String   @db.Text
  callerRef   String?  // caller-supplied reference_id (echoed back)

  status      String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED"
  payload     String   @db.Text // exact JSON body to POST

  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  nextAttemptAt DateTime @default(now())

  responseCode Int?
  responseBody String?  @db.Text
  error        String?  @db.Text

  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // One feedback per (orderKind, orderId, status) so a SUCCESS and a later
  // REJECTED don't collide, but the same final event isn't queued twice.
  @@unique([orderKind, orderId, status])
  @@index([status, nextAttemptAt])
}
