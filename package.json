{
  "name": "nexus-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/kill-port.mjs 3000",
    "dev": "next dev",
    "build": "next build",
    "kill-port": "node scripts/kill-port.mjs 3000",
    "prestart": "node scripts/kill-port.mjs 3000",
    "start": "node scripts/check-db.mjs && next start",
    "start:skip-db-check": "next start",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate-order-codes": "tsx scripts/migrate-order-codes.ts",
    "db:studio": "prisma studio",
    "db:setup": "npm run db:up && sleep 3 && npm run db:push && npm run db:seed",
    "db:status": "node scripts/check-db.mjs"
  },
