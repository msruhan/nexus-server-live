# Paste into Vercel → Project → Settings → Environment Variables (Production)
# Generate secrets: openssl rand -base64 32

# ─── Database (Supabase) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ─── URLs (replace after custom domain) ──────────────────────
AUTH_TRUST_HOST=true
AUTH_URL=https://YOUR-PROJECT.vercel.app
NEXTAUTH_URL=https://YOUR-PROJECT.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app

# ─── Secrets (required in production) ────────────────────────
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# ─── Vercel demo / marketing (recommended) ───────────────────
# Schedulers are off on Vercel unless ENABLE_BACKGROUND_JOBS=true
ENABLE_BACKGROUND_JOBS=false
IMEI_ORDER_SCHEDULER_ENABLED=false
SERVER_ORDER_SCHEDULER_ENABLED=false
WEBHOOK_SCHEDULER_ENABLED=false
BACKUP_SCHEDULER_ENABLED=false

# ─── License portal (required for CSP connect-src + license APIs) ─
# Must be HTTPS in production. Set before build so next.config.mjs CSP allows portal calls.
NEXUS_LICENSE_SERVER_URL=https://YOUR-PORTAL-DOMAIN.vercel.app
# LICENSE_API_SIGNING_SECRET=

# ─── Web Push (PWA) — npx web-push generate-vapid-keys ─────────
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com

# ─── Discord webhook fallback (catalog auto-post) ────────────────
# Optional fallback only; primary config now lives in Admin → Discord Webhook.
DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=
