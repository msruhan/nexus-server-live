# Production — Coolify / customer VPS (PostgreSQL on same VPS)
# Copy to .env.production on the server or paste into Coolify env UI.
# Generate secrets: openssl rand -base64 32  |  openssl rand -hex 32

# ─── Database (Coolify PostgreSQL service) ───────────────────
# Use internal hostname from Coolify (e.g. postgres service name).
DATABASE_URL=postgresql://nexus:CHANGE_ME@postgres:5432/nexus?schema=public
DIRECT_URL=postgresql://nexus:CHANGE_ME@postgres:5432/nexus?schema=public

# ─── Public URLs (customer domain) ─────────────────────────────
AUTH_TRUST_HOST=true
AUTH_URL=https://customer.example.com
NEXTAUTH_URL=https://customer.example.com
NEXT_PUBLIC_APP_URL=https://customer.example.com

# ─── Required secrets ────────────────────────────────────────
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
CRON_SECRET=

# ─── Background jobs (enabled on VPS — unlike Vercel demo) ─────
ENABLE_BACKGROUND_JOBS=true
IMEI_ORDER_SCHEDULER_ENABLED=true
SERVER_ORDER_SCHEDULER_ENABLED=true
WEBHOOK_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_ENABLED=true
IMEI_ORDER_POLL_INTERVAL_MS=90000
WEBHOOK_POLL_INTERVAL_MS=60000

# ─── Persistent paths (mount volumes in Coolify) ──────────────
BACKUP_DIR=/app/storage/backups

# ─── NexusPortal license (production portal URL) ───────────────
NEXUS_LICENSE_SERVER_URL=https://nexus-portal-pied.vercel.app
LICENSE_API_SIGNING_SECRET=

# ─── Optional: after one-click update from Portal ────────────
# NEXUS_RESTART_COMMAND=docker compose -f docker-compose.production.yml restart app

# ─── Docker backup sidecar (if pg_dump not in app container) ─
# BACKUP_DOCKER_CONTAINER=nexus-postgres
