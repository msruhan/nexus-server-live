# Local dev (after: docker compose up -d)
DATABASE_URL="postgresql://nexus:nexus_dev@localhost:5434/nexus?schema=public"

# Production — Supabase (Settings → Database → Connection string → URI)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# API key encryption — wajib saat npm start (NODE_ENV=production)
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY="paste-base64-32-bytes-here"

# Vercel Cron — submit + poll IMEI & server orders every 2 min
CRON_SECRET="generate-with-openssl-rand-base64-32"

# In-process scheduler (optional on Vercel; cron HTTP is primary)
IMEI_ORDER_POLL_INTERVAL_MS=90000
IMEI_ORDER_SCHEDULER_ENABLED=true
SERVER_ORDER_SCHEDULER_ENABLED=true

# Outgoing webhooks (reseller integration) — in-process dispatcher
WEBHOOK_SCHEDULER_ENABLED=true
WEBHOOK_POLL_INTERVAL_MS=60000

# Dev only
STRESS_TEST_MODE=false

# Database backups — directory to store .sql.gz dumps (requires pg_dump in PATH)
# Defaults to ./storage/backups when unset.
BACKUP_DIR="./storage/backups"
# Background backup scheduler (checks due schedule every 15m). Set false to disable.
BACKUP_SCHEDULER_ENABLED=true

# NexusPortal — license activation, validation, and one-click updates
# Must match the portal's public URL (HTTPS in production).
NEXUS_LICENSE_SERVER_URL="http://localhost:4000"
# Same secret as LICENSE_API_SIGNING_SECRET on NexusPortal (openssl rand -hex 32)
LICENSE_API_SIGNING_SECRET=""

# Optional: command run after a successful update (default: pm2 restart nexus-server)
# NEXUS_RESTART_COMMAND="pm2 restart nexus-server"
