# Local dev (after: docker compose up -d)
DATABASE_URL="postgresql://nexus:nexus_dev@localhost:5434/nexus?schema=public"

# Production — Supabase (Settings → Database → Connection string → URI)
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
AUTH_URL="https://your-app.vercel.app"
NEXTAUTH_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# API key encryption — wajib saat npm start (NODE_ENV=production)
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY="paste-base64-32-bytes-here"

# Vercel Cron — submit + poll IMEI & server orders every 2 min
CRON_SECRET="generate-with-openssl-rand-base64-32"

# In-process scheduler (optional on Vercel; cron HTTP is primary)
IMEI_ORDER_POLL_INTERVAL_MS=90000
IMEI_ORDER_SCHEDULER_ENABLED=true
SERVER_ORDER_SCHEDULER_ENABLED=true

# Dev only
STRESS_TEST_MODE=false
